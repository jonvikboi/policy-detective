# Policy Detective Backend

# LLM Configuration (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=qwen/qwen3.6-27b
LLM_PROVIDER=groq

# Database
DATABASE_URL=sqlite+aiosqlite:///./policy_detective.db

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# WebCMD
WEBCMD_BINARY=webcmd
WEBCMD_PROFILE=default
WEBCMD_TIMEOUT=60

# Security
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_MINUTES=15
